START

Display "Welcome to the higher/lower game, Bella!"

// Get valid bounds
Prompt "Enter the lower bound:"
Input lowerBound

Prompt "Enter the upper bound:"
Input upperBound

WHILE lowerBound >= upperBound
    Display "The lower bound must be less than the upper bound."

    Prompt "Enter the lower bound:"
    Input lowerBound

    Prompt "Enter the upper bound:"
    Input upperBound
END WHILE

// Generate random number
randomNumber = Random number between lowerBound and upperBound

// First guess
Display "Great, now guess a number between " + lowerBound + " and " + upperBound + ":"
Input guess

// Continue until correct guess
WHILE guess ≠ randomNumber

    IF guess < randomNumber THEN
        Display "Nope, too low."

    ELSE
        Display "Nope, too high."
    END IF

    Display "Guess another number:"
    Input guess

END WHILE

Display "You got it!"

END
